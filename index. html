<script>

/* ======================
 SECTIONS
====================== */

let left=[
"👤 Profile","🌍 Live News","🔍 Scan Reports","📊 Pump Stocks",
"📋 Trade List","🏦 Investment","📱 Telegram","🎯 Missions",
"📡 Deep Scan","🔗 Broker"
];

let right=[
"📜 Strategy","⚡ Logs","🤖 Trades","💰 Target",
"⚠️ Stop Loss","✅ Confirm","🔥 Challenges","🏆 Achievements",
"🔔 Alerts","🛡️ Security"
];

function create(list,id){
 let c=document.getElementById(id);
 list.forEach(name=>{
  let box=document.createElement("div");
  box.className="box";

  let t=document.createElement("textarea");
  t.placeholder="Enter "+name;
  t.value=localStorage.getItem(name)||"";
  t.oninput=()=>localStorage.setItem(name,t.value);

  box.innerHTML=name;
  box.appendChild(t);
  c.appendChild(box);
 });
}

create(left,"left");
create(right,"right");


/* ======================
 LIVE MARKET
====================== */

async function loadMarket(){
 try{
  let res=await fetch("https://api.binance.com/api/v3/ticker/price?symbols=[\"BTCUSDT\",\"ETHUSDT\"]");
  let data=await res.json();

  let txt="";
  data.forEach(s=>{
    txt+=s.symbol+" : "+s.price+"\n";
  });

  document.querySelectorAll("textarea")[1].value=txt;

 }catch{}
}

setInterval(loadMarket,5000);


/* ======================
 NEWS
====================== */

async function loadNews(){
 try{
  let res=await fetch("https://api.rss2json.com/v1/api.json?rss_url=https://news.google.com/rss/search?q=stock");
  let data=await res.json();

  let txt="";
  data.items.slice(0,5).forEach(n=>{
    txt+="📰 "+n.title+"\n";
  });

  document.querySelectorAll("textarea")[1].value=txt;

 }catch{}
}

setInterval(loadNews,10000);


/* ======================
 PUMP SCANNER
====================== */

async function pump(){
 try{
  let res=await fetch("https://api.binance.com/api/v3/ticker/24hr");
  let data=await res.json();

  let txt="";
  data.slice(0,50).forEach(s=>{
    let ch=parseFloat(s.priceChangePercent);
    if(ch>3){
      txt+=s.symbol+" 🔥 "+ch.toFixed(2)+"%\n";
    }
  });

  document.querySelectorAll("textarea")[3].value=txt;

 }catch{}
}

setInterval(pump,7000);


/* ======================
 AI BOT
====================== */

let bot;

function startBot(){
 bot=setInterval(()=>{
  let rsi=Math.random()*100;
  let trend=Math.random()>0.5?"UP":"DOWN";

  let signal="HOLD";

  if(rsi<30 && trend==="UP") signal="BUY";
  else if(rsi>70 && trend==="DOWN") signal="SELL";

  document.getElementById("signal").value=signal;

  bull.value=Math.floor(Math.random()*100)+"%";
  bear.value=Math.floor(Math.random()*100)+"%";

 },3000);
}

function stopBot(){
 clearInterval(bot);
}


/* ======================
 AI CHAT + VOICE
====================== */

function askAI(){

 let q=document.getElementById("q").value.toLowerCase();
 let res="";

 if(q.includes("buy")) res="Check breakout & volume.";
 else if(q.includes("sell")) res="Sell near resistance.";
 else if(q.includes("profit")) res="Control risk.";
 else res="I am Lion AI trading assistant.";

 ans.value=res;

 let speech=new SpeechSynthesisUtterance(res);
 speechSynthesis.speak(speech);
}

</script>

</body>
